# Clave gratis: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: confirma el nombre del modelo en AI Studio si el predeterminado falla
# GEMINI_MODEL=gemini-3.5-flash

# Alternativa: OpenAI (ChatGPT). Se usa si no hay GEMINI_API_KEY
# OPENAI_API_KEY=
# Opcional: modelo de OpenAI (por defecto gpt-5-mini)
# OPENAI_MODEL=gpt-5-mini

# Alternativa: xAI Grok (si no hay GEMINI_API_KEY ni OPENAI_API_KEY)
# XAI_API_KEY=

# Opcional: forzar un proveedor cuando hay varias claves (openai | gemini | xai)
# AI_PROVIDER=openai
